{
    "kind": "collectionType",
    "collectionName": "courses",
    "info": {
        "singularName": "course",
        "pluralName": "courses",
        "displayName": "Courses"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "title": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "title"
        },
        "description": {
            "type": "text",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "image": {
            "type": "media",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "text": {
            "type": "customField",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "customField": "plugin::ckeditor5.CKEditor",
            "options": {
                "preset": "defaultHtml"
            }
        },
        "price": {
            "type": "integer",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "duration": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "direction": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::direction.direction",
            "inversedBy": "courses"
        },
        "level": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::level.level",
            "inversedBy": "courses"
        },
        "formats": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::format.format"
        },
        "comments": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::comment.comment",
            "mappedBy": "course"
        },
        "seo": {
            "type": "component",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "component": "shared.seo",
            "repeatable": false
        }
    }
}
